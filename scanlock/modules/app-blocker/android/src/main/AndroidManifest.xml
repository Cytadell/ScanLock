<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <activity
      android:name="expo.modules.appblocker.AppBlockerAuthorizationActivity"
      android:excludeFromRecents="true"
      android:exported="false"
      android:screenOrientation="portrait"
      android:theme="@style/ScanLockNativeActivityTheme" />

    <activity
      android:name="expo.modules.appblocker.AppPickerActivity"
      android:excludeFromRecents="true"
      android:exported="false"
      android:screenOrientation="portrait"
      android:theme="@style/ScanLockNativeActivityTheme" />

    <activity
      android:name="expo.modules.appblocker.BlockedAppActivity"
      android:excludeFromRecents="true"
      android:exported="false"
      android:launchMode="singleTask"
      android:screenOrientation="portrait"
      android:taskAffinity="${applicationId}.blocked"
      android:theme="@style/ScanLockNativeActivityTheme" />

    <service
      android:name="expo.modules.appblocker.AppBlockingAccessibilityService"
      android:description="@string/app_blocker_accessibility_description"
      android:exported="true"
      android:label="@string/app_blocker_accessibility_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/app_blocker_accessibility_service" />
    </service>
  </application>
</manifest>
