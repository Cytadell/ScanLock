{
  "expo": {
    "name": "ScanLock",
    "slug": "scanlock",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "orientation": "portrait",
    "scheme": "scanlock",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.cytadelltime.scanlock",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.developer.family-controls": true
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "ScanLock uses the camera only to scan your ScanLock QR key."
      }
    },
    "extra": {
      "eas": {
        "projectId": "0fe15dd6-387b-470e-b7c5-c50de144d890"
      }
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/monochrome-icon.png",
        "backgroundColor": "#7057E8"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.cytadelltime.scanlock"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-camera-only-permissions",
      [
        "expo-camera",
        {
          "cameraPermission": "ScanLock uses the camera only to scan your ScanLock QR key.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7057E8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "./plugins/with-ios-unit-tests"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
